{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms-of-service", "destination": "/terms.html" },
    { "source": "/tos", "destination": "/terms.html" },
    { "source": "/acceptable-use", "destination": "/acceptable-use.html" },
    { "source": "/acceptable-use-policy", "destination": "/acceptable-use.html" },
    { "source": "/aup", "destination": "/acceptable-use.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
